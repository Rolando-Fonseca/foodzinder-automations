# ============================================
# n8n (local con docker compose)
# ============================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=                      # openssl rand -hex 32 ; NO cambiar tras crear credenciales
GENERIC_TIMEZONE=Europe/Madrid
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=                 # contraseña del editor de n8n en local

# Base de datos de n8n (local: el Postgres del compose; Render: Neon)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n_dev

# ============================================
# Foodzinder (P4)
# ============================================
FOODZINDER_BASE_URL=https://foodzinder.vercel.app
FOODZINDER_API_KEY=                      # el FOODZINDER_API_KEY de Foodzinder (Vercel)
FOODZINDER_WEBHOOK_SECRET=               # el WEBHOOK_SECRET de Foodzinder (Vercel)

# ============================================
# Canales e IA
# ============================================
TELEGRAM_BOT_TOKEN=                      # de @BotFather
TELEGRAM_ADMIN_CHAT_ID=                  # chat id del administrador
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                               # cuenta Gmail
SMTP_PASSWORD=                           # contraseña de aplicación de Google
EMAIL_FROM=Foodzinder <no-reply@foodzinder.dev>
GOOGLE_AI_API_KEY=                       # Gemini (la misma de claude-banana)
GEMINI_MODEL=gemini-2.5-flash
