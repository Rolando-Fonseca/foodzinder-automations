{
  "name": "05 · Demo despierta",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "*/10 8-22 * * *" }] } },
      "id": "e0000000-0000-4000-8000-000000000001",
      "name": "Cada 10 min (8-22h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.FOODZINDER_BASE_URL }}/api/v1/restaurants?limit=1",
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      },
      "id": "e0000000-0000-4000-8000-000000000002",
      "name": "ping-foodzinder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "={{ $env.WEBHOOK_URL || $env.N8N_WEBHOOK_URL || 'http://localhost:5678/' }}healthz",
        "options": { "timeout": 30000, "response": { "response": { "neverError": true } } }
      },
      "id": "e0000000-0000-4000-8000-000000000007",
      "name": "ping-n8n (mantener despierto Render)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 480],
      "onError": "continueRegularOutput"
    },
    { "parameters": { "jsCode": "{{code:evaluar-ping}}" }, "id": "e0000000-0000-4000-8000-000000000003", "name": "evaluar-ping", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [480, 300] },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "id": "p1", "leftValue": "={{ $json.shouldAlert }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" },
        "options": {}
      },
      "id": "e0000000-0000-4000-8000-000000000004",
      "name": "¿avisar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.telegramBody) }}",
        "options": { "timeout": 15000 }
      },
      "id": "e0000000-0000-4000-8000-000000000005",
      "name": "telegram-aviso-caida",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200]
    },
    { "parameters": {}, "id": "e0000000-0000-4000-8000-000000000006", "name": "todo bien", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [960, 400] }
  ],
  "connections": {
    "Cada 10 min (8-22h)": { "main": [[{ "node": "ping-foodzinder", "type": "main", "index": 0 }, { "node": "ping-n8n (mantener despierto Render)", "type": "main", "index": 0 }]] },
    "ping-foodzinder": { "main": [[{ "node": "evaluar-ping", "type": "main", "index": 0 }]] },
    "evaluar-ping": { "main": [[{ "node": "¿avisar?", "type": "main", "index": 0 }]] },
    "¿avisar?": { "main": [[{ "node": "telegram-aviso-caida", "type": "main", "index": 0 }], [{ "node": "todo bien", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true, "timezone": "Europe/Madrid" },
  "active": false,
  "tags": [{ "name": "foodzinder" }]
}
